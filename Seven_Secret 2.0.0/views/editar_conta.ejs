<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Perfil - Seven Secrets</title>

    <!-- Fontes Externas -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- CSS da Página -->
    <link rel="stylesheet" href="/css/editar_conta.css">
    
    <!-- Ícones Lucide e Favicon -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="icon" href="/img/ChatGPT Image 29 de mai. de 2026, 19_31_16.png">
    <link rel="stylesheet" href="/css/busca-global.css">
  <link rel="stylesheet" href="/css/modal.css">
  <script src="/js/modal.js"></script>
<link rel="stylesheet" href="/css/store-header.css">
</head>
<body>

    <!-- =========================
          HEADER
    ========================== -->
    <%- include('partials/store-header') %>

    <!-- =========================
          CONTAINER PRINCIPAL
    ========================== -->
    <div class="container">

        <!-- Área Perfil -->
        <div class="profile-area">

            <% if (admin) { %>
            <!-- Atalho exclusivo para administradores -->
            <a href="/cadastro-produtos" class="btn-admin">
                <i data-lucide="package-plus"></i>
                Gerenciar loja
            </a>
            <% } %>

            <div class="section-title">
                <h2>Informações do perfil</h2>
                <div class="line"></div>
            </div>

            <div class="profile-card">

                <h1>Meus dados</h1>

                <p>Edite seus dados para se manter seguro</p>

                <!-- FORMULÁRIO -->
                <form id="profileForm">

                    <!-- NOME -->
                    <div class="input-group">
                        <label>Nome completo</label>
                        <input type="text" id="nome" placeholder="Digite seu nome">
                    </div>

                    <!-- CPF + NASCIMENTO -->
                    <div class="double-input">
                        <div class="input-group">
                            <label>CPF</label>
                            <input type="text" id="cpf" placeholder="000.000.000-00">
                        </div>

                        <div class="input-group">
                            <label>Data nascimento</label>
                            <input type="date" id="nascimento">
                        </div>
                    </div>

                    <!-- EMAIL -->
                    <div class="input-group">
                        <label>E-mail</label>
                        <input type="email" id="email" placeholder="Digite seu email">
                    </div>

                    <!-- SENHA -->
                    <div class="input-group">
                        <label>Senha</label>
                        <input type="password" id="senha" placeholder="Digite sua senha">
                    </div>

                    <button type="submit">EDITAR</button>

                </form>

                <!-- SAIR DA CONTA -->
                <button type="button" id="btnSair" class="btn-sair">
                    <i data-lucide="log-out"></i>
                    Sair da conta
                </button>

            </div>

        </div>

        <!-- Histórico de Compras -->
       
<!-- Histórico de Compras -->

<!-- Histórico de Compras -->
<div
    class="history-area"
    role="region"
    tabindex="0"
    aria-labelledby="history-title"
    aria-describedby="history-description"
>

    <div class="section-title">
        <h2 id="history-title">Histórico de compras</h2>
        <div class="line"></div>
    </div>

    <p id="history-description" class="sr-only">
        Histórico de compras da sua conta.
        Consulte os produtos adquiridos, quantidades,
        valores totais e situação dos pedidos.
    </p>

    <div class="history-card">

        <div class="history-header">
            <span>Produtos</span>
            <span>Quantidade</span>
        </div>

        <div class="historico-container">
        </div>

        <div id="productsContainer"></div>

    </div>

</div>
<!-- Fim do Histórico de Compras -->

</div>
<!-- Fim do container principal -->

    <!-- RODAPÉ -->
    <footer>
        <div class="footer-simple">
            <div class="footer-logo">Seven Secrets</div>
            
            <nav class="footer-nav">
                <a href="/sem-produtos">A Marca</a>
                <a href="#">Contato</a>
                <a href="#">Privacidade</a>
            </nav>

            <div class="footer-socials">
                <a href="#"><i data-lucide="instagram"></i></a>
                <a href="#"><i data-lucide="facebook"></i></a>
                <a href="#"><i data-lucide="twitter"></i></a>
            </div>

            <p class="copyright">Seven Secrets &copy; 2026. Alta Perfumaria Exclusiva.</p>
        </div>
    </footer>

    <!-- Script de front-end -->
    <script src="/js/editar_conta.js"></script>

    <!-- Inicialização dos ícones -->

    <script src="/js/busca-global.js" defer></script>
  <%- include("partials/modal") %>
</body>
</html>
